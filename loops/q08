// A C program to calculate the factorial of a given number.
#include <stdio.h>
int main()
{
    int n, i;
    long long fact = 1;
    printf("Enter n:\n");
    scanf("%d",&n);
    for(i = 1; i <= n; i++)
        {
            fact = fact * i;
        }
    printf("factorial of %d is %lld.",n,fact);
    return 0;
}
