// A C program to calculate the sum of even numbers from 1 to n.
#include <stdio.h>
int main()
{
    int n, i, sum = 0;
    printf("Enter the number n:\n");
    scanf("%d",&n);
    for(i=2; i <= n; i+=2)
        {
            sum = sum + i;
        }
    printf("Sum of even numbers between 1 and %d is %d.",n ,sum);
    return 0;
}
