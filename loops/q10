// A C program to calculate the sum of even numbers from 1 to n.
#include <stdio.h>
int main()
{
    int num, copy, sum = 0, rem;
    printf("Enter the number n:\n");
    scanf("%d",&num);
    copy=num;
    for(; num > 0; num = num/10)
        {
            rem = num % 10;
            sum = sum + rem;
        }
    printf(" sum of digits in %d is %d.",copy,sum);
    return 0;
}
